<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Rimuove il baget.lottomatica.com e usa solo NuGet.org -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <!-- Disabilita esplicitamente il baget se presente -->
    <add key="baget.lottomatica.com" value="true" />
  </disabledPackageSources>
</configuration>
